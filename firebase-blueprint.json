{
  "entities": {
    "Session": {
      "title": "Session",
      "description": "Visitor active session tracking info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "location": { "type": "string" },
        "deviceType": { "type": "string" },
        "userAgent": { "type": "string" },
        "referrer": { "type": "string" },
        "firstSeen": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["id", "visitorId", "location", "deviceType", "userAgent", "referrer", "firstSeen", "lastActive"]
    },
    "Pageview": {
      "title": "Pageview",
      "description": "Individual page view log",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "visitorId": { "type": "string" },
        "location": { "type": "string" },
        "deviceType": { "type": "string" },
        "referrer": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["sessionId", "visitorId", "location", "deviceType", "referrer", "timestamp"]
    },
    "Action": {
      "title": "Action",
      "description": "User logged action (search, click, filter, etc.)",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "visitorId": { "type": "string" },
        "location": { "type": "string" },
        "action": { "type": "string" },
        "type": { "type": "string", "enum": ["search", "view", "filter", "download", "share", "inquiry"] },
        "timestamp": { "type": "string" }
      },
      "required": ["sessionId", "visitorId", "location", "action", "type", "timestamp"]
    },
    "NpsDimension": {
      "title": "NpsDimension",
      "description": "Nominal Pipe Size dimensions and schedules reference data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nps": { "type": "string" },
        "dn": { "type": "number" },
        "od": { "type": "number" },
        "schedules": {
          "type": "object",
          "description": "Schedule names and their wall thicknesses in mm"
        }
      },
      "required": ["id", "nps", "dn", "od", "schedules"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User bug report or feedback form submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["bug", "suggestion", "inquiry", "other"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "ignored"] },
        "attachmentName": { "type": "string" },
        "attachmentType": { "type": "string" },
        "attachmentData": { "type": "string" }
      },
      "required": ["id", "name", "type", "message", "timestamp", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "App notification and integration settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "web3FormsKey": { "type": "string" },
        "emailNotificationsEnabled": { "type": "boolean" },
        "notificationRecipient": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "sessions/{sessionId}": {
      "schema": "Session",
      "description": "Active visitor sessions"
    },
    "pageviews/{pageviewId}": {
      "schema": "Pageview",
      "description": "Pageview logging history"
    },
    "actions/{actionId}": {
      "schema": "Action",
      "description": "Visitor custom interactions and search actions"
    },
    "nps_dimensions/{dimensionId}": {
      "schema": "NpsDimension",
      "description": "ASME/ANSI B36.10 Pipe Dimensions chart"
    },
    "feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "User bug reports and system feedback submissions"
    },
    "settings/{settingsId}": {
      "schema": "Settings",
      "description": "General system configuration"
    }
  }
}
