rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Path Variable Hardening ID Validator
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to get incoming data
    function incoming() {
      return request.resource.data;
    }

    // 3. Sessions Rules
    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update: if isValidId(sessionId)
        && (incoming().keys().hasAny(['id', 'visitorId', 'lastActive', 'location', 'deviceType', 'referrer', 'userAgent', 'firstSeen']));
    }

    // 4. Pageviews Rules
    match /pageviews/{pageviewId} {
      allow get, list: if true;
      allow create: if isValidId(pageviewId)
        && (incoming().keys().hasAny(['sessionId', 'visitorId', 'timestamp', 'location', 'deviceType', 'referrer']));
    }

    // 5. Actions Rules
    match /actions/{actionId} {
      allow get, list: if true;
      allow create: if isValidId(actionId)
        && (incoming().keys().hasAny(['sessionId', 'visitorId', 'timestamp', 'location', 'action', 'type']));
    }

    // 6. NPS Dimensions Rules
    match /nps_dimensions/{dimensionId} {
      allow read, write: if true;
    }

    // 7. Feedbacks Rules
    match /feedbacks/{feedbackId} {
      allow get, list: if true;
      allow create: if isValidId(feedbackId)
        && (incoming().keys().hasAny(['id', 'name', 'email', 'type', 'message', 'timestamp', 'status', 'attachmentName', 'attachmentType', 'attachmentData']))
        && incoming().name is string && incoming().name.size() > 0
        && incoming().message is string && incoming().message.size() > 0;
      allow update, delete: if true;
    }

    // 8. Settings Rules
    match /settings/{settingsId} {
      allow read, write: if true;
    }
  }
}
